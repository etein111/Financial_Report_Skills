# Neolyst 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# ===== Supabase 配置 =====
# Supabase 项目 URL (在 Supabase Dashboard -> Settings -> API 中查找)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (公开密钥,用于前端)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (服务端密钥,仅用于后端,谨慎保管)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== 后端配置 =====
# 后端服务端口
BACKEND_PORT=8000

# 后端运行环境 (development/production)
BACKEND_ENV=development

# ===== 前端配置 =====
# 前端开发服务器端口
VITE_PORT=5173

# API 基础地址 (前端调用后端 API 时使用)
VITE_API_BASE_URL=http://localhost:8000

# ===== 数据库配置 =====
# Supabase 数据库连接字符串 (如果需要直接连接数据库)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
